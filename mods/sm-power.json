{
  "schema": 1,
  "id": "sm-power",
  "name": "Botón de apagado redondo",
  "category": "Menú Inicio",
  "description": "Botón de apagado circular con fondo propio.",
  "author": "WinStyler",
  "version": "1.0",
  "compat": {
    "min_build": 22000
  },
  "restart": "none",
  "settings": [
    {
      "key": "color",
      "label": "Fondo",
      "type": "color",
      "default": "#33FFFFFF"
    }
  ],
  "rules": [
    {
      "process": "start",
      "target": "StartDocked.NavigationPaneButton#PowerButton > Grid > Border#BackgroundBorder",
      "styles": [
        "CornerRadius=20",
        "Background={color}"
      ]
    }
  ]
}